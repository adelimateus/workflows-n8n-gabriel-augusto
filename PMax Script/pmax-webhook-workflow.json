    {
      "parameters": {
        "jsCode": "// Extrai as linhas do payload enviado pelo script PMax v29-webhook\n// e adiciona metadados de controle a cada linha\nconst payload = $('Webhook PMax').first().json;\nconst { report, account_id, timestamp, batch, total_batches, total_rows, rows } = payload;\n\nif (!rows || rows.length === 0) {\n  return [];\n}\n\nreturn rows.map(row => ({\n  json: {\n    _report:        report,\n    _account_id:    account_id,\n    _timestamp:     timestamp,\n    _batch:         batch,\n    _total_batches: total_batches,\n    _total_rows:    total_rows,\n    ...row\n  }\n}));"
      },
      "id": "f8c6b7a9-d0e1-4f2c-3b4a-5c6d7e8f9a0b",
